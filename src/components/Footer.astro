---
import { SITE } from "../../site.config.ts";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="frame foot">
    <p class="colophon">© {year} {SITE.name} · Made slowly, with care.</p>
    <ul>
      {SITE.social.map((s) => <li><a class="quiet-link" href={s.href} rel="me noopener">{s.label}</a></li>)}
      <li><a class="quiet-link" href="/rss/">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-section); border-top: 1px solid var(--line); }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 2rem; padding-block: 2rem 2.5rem; }
  .colophon { margin: 0; font-size: 0.875rem; color: var(--muted); }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
</style>
