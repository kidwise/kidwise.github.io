---
import { SITE } from "../../site.config.ts";
import Seal from "./Seal.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/thoughts/", label: "Thoughts" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname.replace(/\/?$/, "/");
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="frame bar">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <Seal />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.25rem; }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-serif); font-size: 1.3rem; text-decoration: none; color: var(--ink);
    letter-spacing: -0.01em;
  }
  nav { display: flex; align-items: center; gap: 0.5rem; }
  ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  ul a {
    display: block; padding: 0.35rem 0.7rem; border-radius: 999px;
    font-size: 0.9rem; color: var(--muted); text-decoration: none;
    transition: color .3s var(--ease);
  }
  ul a:hover { color: var(--ink); }
  ul a[aria-current="page"] { color: var(--ink); }
  ul a[aria-current="page"]::after {
    content: ""; display: block; height: 1px; margin-top: 2px;
    background: var(--moss); border-radius: 1px;
  }
  @media (max-width: 560px) {
    .bar { height: auto; padding-block: 0.85rem; flex-wrap: wrap; row-gap: 0.4rem; }
    nav { width: 100%; justify-content: space-between; margin-inline: -0.7rem; width: calc(100% + 1.4rem); }
    ul a { padding-inline: 0.7rem; }
  }
</style>
