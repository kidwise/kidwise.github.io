<button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">
  <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
  <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
</button>
<script is:inline>
  (() => {
    const btn = document.currentScript.previousElementSibling;
    const root = document.documentElement;
    const isDark = () => root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;
    btn.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
    });
  })();
</script>
<style>
  .theme-toggle {
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border: 0; border-radius: 999px; background: transparent;
    color: var(--muted); cursor: pointer;
    transition: color .3s var(--ease), background-color .3s var(--ease);
  }
  .theme-toggle:hover { color: var(--ink); background: var(--mist); }
  .i-sun { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun { display: block; }
    :global(:root:not([data-theme="light"])) .i-moon { display: none; }
  }
  :global(:root[data-theme="dark"]) .i-sun { display: block; }
  :global(:root[data-theme="dark"]) .i-moon { display: none; }
</style>
